---
import { CV, PROFILE, type Lang } from '../data/cv';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = CV[lang];
const links = [
	['#elements', t.nav.elements],
	['#experience', t.nav.experience],
	['#education', t.nav.education],
	['#lab', t.nav.lab],
	['#contact', t.nav.contact],
];
---

<header>
	<nav class="wrap" aria-label="Navigation">
		<a class="brand" href={lang === 'fr' ? '/' : '/en/'}>
			<span class="dot" aria-hidden="true"></span>{PROFILE.name}
		</a>
		<ul class="links">
			{links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
		</ul>
		<div class="tools">
			<a class="lang" href={t.ui.langHref} hreflang={lang === 'fr' ? 'en' : 'fr'}>{lang === 'fr' ? 'EN' : 'FR'}<span class="sr-only"> · {t.ui.lang}</span></a>
			<button class="theme" type="button" aria-label={t.ui.theme} title={t.ui.theme}>
				<svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path></svg>
				<svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"></path></svg>
			</button>
		</div>
	</nav>
</header>

<script>
	const root = document.documentElement;
	const isDark = () =>
		root.dataset.theme ? root.dataset.theme === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
	document.querySelector('header .theme')?.addEventListener('click', () => {
		const next = isDark() ? 'light' : 'dark';
		root.dataset.theme = next;
		try {
			localStorage.setItem('theme', next);
		} catch (e) {}
	});
</script>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: color-mix(in srgb, var(--bg) 82%, transparent);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--line);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		height: 4rem;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		font-family: var(--font-display);
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
	}
	.dot {
		width: 0.65rem;
		height: 0.65rem;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 0 4px var(--accent-soft);
	}
	.links {
		display: flex;
		gap: 1.6rem;
		font-size: 0.92rem;
	}
	.links a {
		text-decoration: none;
		color: var(--muted);
		transition: color 0.15s ease;
	}
	.links a:hover {
		color: var(--text);
	}
	.tools {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}
	.lang,
	.theme {
		display: inline-grid;
		place-items: center;
		height: 2.2rem;
		min-width: 2.2rem;
		padding: 0 0.6rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: transparent;
		color: var(--text);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		text-decoration: none;
		cursor: pointer;
	}
	.lang:hover,
	.theme:hover {
		border-color: var(--text);
	}
	.moon {
		display: none;
	}
	:global(:root[data-theme='dark']) .sun {
		display: none;
	}
	:global(:root[data-theme='dark']) .moon {
		display: block;
	}
	@media (prefers-color-scheme: dark) {
		:global(:root:not([data-theme='light'])) .sun {
			display: none;
		}
		:global(:root:not([data-theme='light'])) .moon {
			display: block;
		}
	}
	@media (max-width: 820px) {
		.links {
			display: none;
		}
	}
</style>
